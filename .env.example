NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: enables the "Explore the demo (read-only)" button on the login page.
# Create this user in Supabase (Authentication -> Add user, set a password,
# auto-confirm), seed it with supabase/seed_demo.sql, and make it read-only
# with supabase/demo_readonly.sql. Server-only — never exposed to the client.
# DEMO_EMAIL=demo@example.com
# DEMO_PASSWORD=<generate one: openssl rand -base64 24>
